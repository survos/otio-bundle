    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "symfony": {
    "controllers": {},
    "importmap": {
      "@survos/otio-bundle/player": "path:%PACKAGE%/dist/player.js"
